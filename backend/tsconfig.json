{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "strict": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "baseUrl": ".",
    "paths": {
      "*": ["./node_modules/*"],
      "express": ["./node_modules/@types/express"],
      "@modules/*": ["../modules/*"],
      "@shared/*": ["../shared/*"],
      "@providers/*": ["../providers/*"],
      "@infrastructure/*": ["../infrastructure/*"]
    }
  },
  "include": [
    "src/**/*",
    "../modules/**/*",
    "../providers/**/*",
    "../shared/**/*",
    "../infrastructure/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
